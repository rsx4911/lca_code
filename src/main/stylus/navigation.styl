nav
	position fixed
	background-color rgb(43, 51, 61)
	height 100%
	width 65px
	margin-top 65px
	color rgb(197, 208, 222)
	font-size 15px
		
	@media(min-width 992px)
		width 230px
				
	ul 
		margin-top 10px

		li 
			width 100%
			line-height 40px

			&.active
				background-color rgb(36, 39, 45)
			
			&:not(.active):hover
				background-color rgb(51, 60, 71)
		
			a
				display block
				width 100%
				height 100%
				padding 0 24px
				
			a, a:hover, a:visited, a:active, a:focus
				text-decoration none
				
			.nav-icon
				width 16px
				height 16px
				
			.nav-label
				padding-left 10px

				@media(max-width 991px)
					display none
						
	.profile-link
		background-color rgb(43, 51, 61)
		padding 10px 20px
		position fixed
		bottom 0
		overflow hidden

		@media(min-width 992px)
			width 230px

		@media(max-width 991px)
			padding 8px

		.username
			line-height 48px
			padding-left 10px

			@media(max-width 991px)
				display none
