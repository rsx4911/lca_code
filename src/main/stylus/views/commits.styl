.full-size > .center > .repository-commits
		padding 0

.repository-commits
	
	.commit-group
		width 100%
		padding 10px 20px
		border-bottom 1px solid rgb(221, 221, 221)
		
		.date-and-count
			float left
			width 200px
			
			.count
				color rgb(127, 143, 164)
				font-size 90%
	
		.commit
			margin-left 200px
			padding 0 10px 10px 10px

			&:not(:first-child)
				padding 10px
			
			&:not(:last-child)
				border-bottom 1px solid rgb(221, 221, 221)

			.commit-details
				
				.commit-message
					font-weight bold
								
			.commit-link
				width 270px

				& > a
					color rgb(127, 143, 164)
					font-size 90%
