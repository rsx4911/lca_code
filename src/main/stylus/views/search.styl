.search-view

	& > *
		padding 0

	.result
		padding 10px 25px
		border-bottom 1px solid rgb(231, 233, 237)	

		&:not(:first-child)
			border-top 1px solid rgb(231, 233, 237)
			
		.details
			font-size 90%
			color rgb(119, 119, 119)
			margin-left 21px
			
	.highlight-result
		background-color rgb(255, 255, 0)
	
	.aggregations
		
		@media(min-width 1200px)
			margin-left 25px
		
		.aggregation
			padding 10px 25px				