.full-size > .center > .repository-dataset
	padding 0

.repository-dataset

	a, a:hover, a:visited, a:active, a:focus
		
		&:not(.btn)
			color rgb(51, 122, 183)

	.filter-box .form-inline
		float left

	.model-left-content
		border-bottom 1px solid rgb(221, 221, 221)

		@media(min-width 768px)
			float left
			width 75%
			border-right 1px solid rgb(221, 221, 221)
			border-bottom 0

		.title, .content
			padding 0 25px
			
			&:first-child
				padding-top 25px
				
			&:last-child
				padding-bottom 25px		
				
		.table.no-head > tbody 
			
			& > tr:first-child > td
				border 0

		.table.inputs > tbody > tr > td:first-child, .table.outputs > tbody > tr > td:first-child
			width 35px

		.table.units > thead > tr > th, .table.units > tbody > tr > td, .table.flow-properties > thead > tr > th, .table.flow-properties > tbody > tr > td
			text-align center

		.table.units > thead > tr > th, .table.units > tbody > tr > td

			&:first-child
				width 60px

			&:nth-child(2)
				width 30%
				
			&:nth-child(2), &:nth-child(3)
				@media(max-width 767px)
					display none

		.table > tbody > tr

			& > td:first-child
				width 25%

			&.reference > td 
				font-weight bold
		
		img.icon-small
			width 16px
			height 16px

		.map
			height 400px
			width 100%

	.model-right-content
		padding 25px

		@media(min-width 768px)
			float right
			width 25%

		strong
			color rgb(80, 80, 80)
	