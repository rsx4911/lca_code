.full-size > .center > .repository-dataset
	padding 0

.repository-dataset
	
	.header-box
		
		.user-info
			display block
			margin-top 10px
	
	@media(min-width 768px)
		.content-box
			display flex

	.category
		color rgb(127, 143, 164)

	a, a:hover, a:visited, a:active, a:focus
		
		&:not(.btn)
			color rgb(51, 122, 183)

	.header-box .form-inline
		float left

	.model-left-content
		border-bottom 1px solid rgb(221, 221, 221)

		@media(min-width 768px)
			float left
			width 75%
			border-right 1px solid rgb(221, 221, 221)
			border-bottom 0

		.nav-tabs > li
			
			@media(max-width 479px)
				float none

		.title, .content
			padding 0 25px
			margin-top 0
			
			&:first-child
				padding-top 25px
				
			&:last-child
				padding-bottom 25px		

		.table > tbody > tr

			& > td:first-child
				width 25%

			&.reference > td 
				font-weight bold

		.table.no-head > tbody > tr:first-child > td
			border 0

		#impact-category-group
			margin-bottom 5px
			
		.impact-category-description
			margin-top 0
			color rgb(119, 119, 119)

		#documentation

			.table.no-head > tbody > tr > td:first-child
				padding-left 0

			.table.no-head > tbody > tr:first-child > td
				padding-top 0

		.table.inputs > tbody > tr > td, .table.inputs > thead > tr > th, .table.outputs > tbody > tr > td, .table.outputs > thead > tr > th
			
			&:first-child
				width 35px

			&:nth-child(3), &:nth-child(7)

				@media(max-width 479px)
					display none

			&:nth-child(5), &:nth-child(6)

				@media(max-width 767px)
					display none

		.table.allocation-factors > tbody > tr > td, .table.allocation-factors > thead > tr > th
			
			&:first-child
				width 35px
		
		.table.social-aspects 
			
			& > tbody > tr > td, & > thead > tr > th

				&:first-child
					width auto
					
				@media(max-width 767px)

					&:nth-child(5), &:nth-child(6), &:nth-child(7)
						display none
	
		.table-parameters > tbody > tr > td:nth-child(3), .table-parameters > thead > tr > th:nth-child(3)

			@media(max-width 479px)
				display none

		.table.units > thead > tr > th, .table.units > tbody > tr > td, .table.flow-properties > thead > tr > th, .table.flow-properties > tbody > tr > td
			text-align center

		.table.units > thead > tr > th, .table.units > tbody > tr > td

			&:first-child
				width 60px

			&:nth-child(2)
				width 30%
				
			&:nth-child(2), &:nth-child(3)

				@media(max-width 767px)
					display none
		
		img.icon-small
			width 16px
			height 16px

		.map
			height 400px
			width 100%

	.model-right-content
		padding 25px

		@media(min-width 768px)
			float right
			width 25%

		strong
			color rgb(80, 80, 80)
	