.full-size
	max-width 1200px

	@media(min-width 992px)
		margin 25px auto

	& > .center
	
		@media(min-width 992px)
			margin 0 25px
						
		.two-columns > *:not(.clear)

			@media(min-width 992px)
				margin 1%
				width 48%
				float left

		.three-columns > *:not(.clear)

			@media(min-width 992px)
				margin 1%
				width 31.3%
				float left

		.four-columns > *:not(.clear)

			@media(min-width 992px)
				margin 1%
				width 23%
				float left

		.two-columns.special

			@media(min-width 992px)
				display flex

				& > *:last-child
					display flex

				.flex-container
					width 100%
					background-color rgb(255, 255, 255)
						
			@media(min-width 1120px)

				& > *:first-child
					width 55% !important

				& > *:last-child
					width 41% !important

			@media(min-width 1220px)

				& > *:first-child
					width 58% !important

				& > *:last-child
					width 38% !important
					
			@media(min-width 1320px)

				& > *:first-child
					width 63% !important

				& > *:last-child
					width 33% !important
