.paging 
	padding-top 20px
	text-align center

	& > *
		padding-right 3px
		
	a, a:hover, a:visited, a:active, a:focus 
		color rgb(51, 122, 183)
		
.avatar 
	width 48px
	height 48px
	border-radius 24px

.alert
	display none
	
.status-bar
	position fixed
	top -40px
	left 0
	height 40px
	width 100%
	padding 10px 0
	border-width 1px
	border-style solid
	font-weight bold
	text-align center
	z-index 10000

.status-bar:not(.alert-danger):not(.alert-success):not(.alert-warning):not(.alert-info)
	display none
	
.filter-box
	padding 25px
	background-color rgb(248, 250, 252)
	border-bottom 1px solid rgb(231, 233, 237)

	input.filter
		width 200px
		margin-bottom 5px
	
	button > .glyphicon
		font-size 14px
		padding-right 5px
