option[disabled]
	color rgb(160, 160, 160)

.fadeIn
	animation-duration 0.25s
	-webkit-animation-delay 0s

.pace
	-webkit-pointer-events none
	pointer-events none
	-webkit-user-select none
	-moz-user-select none
	user-select none

	.pace-progress
		background rgb(92, 184, 92)
		position fixed
		z-index 2000
		top 0
		right 100%
		width 100%
		height 2px

.pace-inactive
	display none

.paging 
	padding-top 20px
	text-align center

	& > *
		padding-right 3px
		
	a, a:hover, a:visited, a:active, a:focus 
		color rgb(51, 122, 183) !important
		
.avatar 
	width 48px
	height 48px
	border-radius 24px

.alert
	display none

.status-bar
	position fixed
	top -40px
	left 0
	height 40px
	width 100%
	padding 10px 0
	border-width 1px
	border-style solid
	font-weight bold
	text-align center
	z-index 10000

table > thead > tr > th.header:not(:empty)
	cursor pointer
		
	&:after
		position relative
		left 10px

	&.headerSortDown:after
		content '\2303'
		top 3px
			
	&.headerSortUp:after
		content '\2304'
		top -3px

.tab-content
	margin 15px
	overflow auto

.btn-full-width
	width 100%
	
.status-bar:not(.alert-danger):not(.alert-success):not(.alert-warning):not(.alert-info)
	display none
	
.header-box, .subheader-box
	background-color rgb(248, 250, 252)
	border-bottom 1px solid rgb(231, 233, 237)
	border-top 1px solid rgb(231, 233, 237)

.header-box
	padding 25px

	#commitId
		width 112px

	.form-group
		margin-bottom 0

	input.filter
		width 200px
		margin-bottom 5px

	.btn > .glyphicon
		font-size 14px

	.btn:not(:last-child) 
		margin-left 10px
	
.btn > .glyphicon + .text
	
	@media(min-width 481px)
		padding-left 5px

select[multiple].member-selection
	height 200px
	
optgroup.additional-info
	font-weight 100 !important
	font-style italic !important
	color rgb(160, 160, 160) !important

.content-box, .subcontent-box
	background-color white

.subheader-box
	padding 10px
	border-left 1px solid rgb(231, 233, 237)
	border-right 1px solid rgb(231, 233, 237)

.multi-box-view
	
	.header-box
		font-size 18px

		.pull-right
			
			&.btn-lg, &.avatar
				margin-top -12px

	.content-box
		padding 25px

		&:not(:last-child)

			@media(min-width 992px)
				margin-bottom 25px

.user-info

	&.concealed
		color rgb(127, 143, 164)
		
	&:not(.concealed)
		font-weight bold

	img.avatar-small
		width 32px
		height 32px

	.username
		padding-left 10px
		font-size 90%

img.model-icon
	width 64px
	height 64px
	margin 0 0 0 50px
	
img.model-icon-small
	width 16px
	height 16px
	margin -3px 5px 0 0

table.data-quality

	& > tbody > tr > td:first-child
		font-weight bold
	
	& > tbody > tr
		border-top 1px solid rgb(238, 238, 238)

	& > thead > tr > th, & > tbody > tr > td
		padding 5px
		text-align center
		min-width 50px
		height 50px
			
		&:not(:first-child)
			border-left 1px solid rgb(238, 238, 238)

		@media(max-width 767px)
			min-width 30px
			height 30px

			& > span
				display none

			&:first-child
				word-break break-all
				
	&:not(.uncertainties) 
		
		& > thead > tr > th, & > tbody > tr > td
			
			&:not(:first-child)
				word-break break-all