include ../mixins/user-info.pug

.list-entry.activity
    +user-info(user, userDisplayName)
        span  pushed to 
        a(href=repositoryId)=repositoryId
        span  on #{formatDate(timestamp)} at #{formatTime(timestamp)}
        .activity-info
            |  
            a(href=repositoryId + '/commit/' + id)=id
            br
            span.message  #{message}