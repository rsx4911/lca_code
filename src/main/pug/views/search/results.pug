include ../mixins/forms.pug
include ../mixins/paging.pug
include ./result.pug
include ./aggregation.pug


.header-box
	| #{resultInfo.totalCount} results
	if query
		|  for '#{query}'
	div 
		each key in Object.keys(selectedAggregations)
			- var value = selectedAggregations[key][0];
			.badge=getLabel(key, value)
				|  
				a(href=getAggregationUrl(key, value, true)): span.glyphicon.glyphicon-remove
.content-box
	.search-results(class=typeFiltered?'col-lg-8':'col-lg-9')
		each dataset in data
			+result(dataset)
		+paging(resultInfo, getPagingUrl)
	.aggregations(class=typeFiltered?'col-lg-4':'col-lg-3')
		each aggregation in aggregations
			+aggregation(aggregation)
	.clear