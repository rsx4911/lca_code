include forms.pug

mixin login-form() 
	form#login&attributes(attributes)
		h3 Sign in
		#login-general-message.alert.alert-danger(role='alert'): span.message
		+input('username', 'Username')
		+input('password', 'Password', 'password')
			a.default-link(href='#' data-action='reset-password') Forgot your password?
		+input('token', 'Token', 'text', false, false, true)
			a.default-link(href='login') Login with another user
		block
	
mixin reset-password-form()
	form#reset-password&attributes(attributes)
		h3 Reset password
		#reset-password-general-message.alert.alert-success(role='alert'): span.message
		+input('email', 'E-Mail')
			a.default-link(href='#' data-action='login') Back to login
		block
