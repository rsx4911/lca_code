.header-box Server info
.content-box
    div Release version: {{releaseVersion}}
    div Commit id: {{commitId}}
    div Build date: {{buildDate}}
.header-box Maintenance mode
    button.btn.btn-lg.pull-right.toggle-maintenance-mode(class=maintenanceModeActive?'btn-success':'btn-danger')
        if maintenanceModeActive
            | Deactivate maintenance mode
        else
            | Activate maintenance mode
