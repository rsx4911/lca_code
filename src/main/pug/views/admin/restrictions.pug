.header-box Restricted data sets
	button.btn.btn-success.pull-right(data-action='add') Add restriction set
.content-box
	if !restrictions || !restrictions.length
		em No restrictions set
	each set in restrictions
		.entry #{set.name} (#{set.count} data set ids)
			.btn.btn-default.btn-xs.pull-right(data-action='show' data-restriction=set.name) Show
			.btn.btn-warning.btn-xs.pull-right(data-action='replace' data-restriction=set.name) Replace
			.btn.btn-danger.btn-xs.pull-right(data-action='delete' data-restriction=set.name) Delete