.header-box
	.btn.btn-success.pull-right(data-action='add') Add restriction
	.clear
.content-box
	each restriction in restrictions
		.entry #{restriction.name} (#{restriction.count} data set ids)
			.btn.btn-default.btn-xs.pull-right(data-action='show' data-restriction=restriction.name) Show
			.btn.btn-warning.btn-xs.pull-right(data-action='replace' data-restriction=restriction.name) Replace
			.btn.btn-danger.btn-xs.pull-right(data-action='delete' data-restriction=restriction.name) Delete