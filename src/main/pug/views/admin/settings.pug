include ../mixins/forms.pug

#settings-form
	.header-box Basic settings
		button.btn.btn-primary.pull-right(data-action='test-search') Run test search
		button.btn.btn-primary.pull-right(data-action='test-glad') Check GLAD url
	.content-box
		.two-columns
			+input('SERVER_NAME', 'Server name')
			+input('SERVER_URL', 'Server base url (e.g. used in email links)')
		.clear
		.two-columns
			+input('REPOSITORY_PATH', 'Repositories root directory')
			+input('LIBRARY_PATH', 'Root directory for library id files')
		.clear
		.three-columns
			+input('GLAD_URL', 'Glad service base url')
			+input('GLAD_API_KEY_HEADER', 'Glad service api-key header field')
			+input('GLAD_API_KEY', 'Glad service api-key header value')
		.clear
		.four-columns
			+input('SEARCH_CLUSTER', 'Elasticsearch cluster')
			+input('SEARCH_HOST', 'Elasticsearch url')
			+input('SEARCH_PORT', 'Elasticsearch port')
			+input('SEARCH_INDEX_NAME', 'Elasticsearch index')
		.clear
	.header-box Enabled features
	.content-box
		+checkbox('COMMENTS_ENABLED', 'Comments: Reviewers are enabled to make comments on data set fields')
		+checkbox('TASKS_ENABLED', 'Tasks: Editors can create review tasks')
		+checkbox('MESSAGING_ENABLED', 'Messaging: Users can write messages to each other')
		+checkbox('PUBLIC_REPOSITORY_ENABLED', 'Public repositories: Repositories can be marked as publicly accessible')
		+checkbox('NOTIFICATIONS_ENABLED', 'Notifications</strong>: Users can receive notifications')
		+checkbox('USER_REGISTRATION_ENABLED', 'User registration</strong>: Users can create accounts themselfes')
		.indented-setting
			+checkbox('USER_REGISTRATION_APPROVAL_ENABLED', 'User registration approval</strong>: Self signed-up users will be inactive until an admin activates them')
		+checkbox('DASHBOARD_ACTIVITIES_ENABLED', 'Dashboard activities</strong>: Shows latest activities on the dashboard')
		+checkbox('REPOSITORY_ACTIVITIES_ENABLED', 'Repository activities</strong>: Shows latest activities in each repository')
		+checkbox('HOMEPAGE_ENABLED', 'Homepage</strong>: Show a landing page instead of the default search page for anonymous users')
	.header-box Mail configuration 
		button.btn.btn-primary.pull-right(data-action='test-mail') Send test mail
		.clear
	.content-box
		.two-columns
			+input('MAIL_HOST', 'Host')
			.three-columns
				+select('MAIL_PROTO', 'Protocol', ['smtp', 'smtps'])
				+input('MAIL_PORT', 'Port', 'integer')
				div
					+checkbox('MAIL_SSL', 'SSL')
					+checkbox('MAIL_TLS', 'TLS')
		.clear
		.two-columns
			+input('MAIL_USER', 'Username')
			+input('MAIL_PASS', 'Password', 'password')
		.clear
		.two-columns
			+input('MAIL_DEFAULT_FROM', 'Default from')
			+input('MAIL_DEFAULT_REPLY_TO', 'Default reply to')
		.clear
	.header-box Imprint
	.content-box
		.two-columns
			+input('IMPRINT_COMPANY', 'Company')
			+input('IMPRINT_CEO', 'Ceo')
		.clear
		.two-columns
			+input('IMPRINT_STREET', 'Street')
			+input('IMPRINT_ZIP_CODE', 'Zip code')
		.clear
		.two-columns
			+input('IMPRINT_CITY', 'City')
			+input('IMPRINT_COUNTRY', 'Country')
		.clear
		.two-columns
			+input('IMPRINT_PHONE', 'Phone')
			+input('IMPRINT_FAX', 'Fax')
		.clear
		.two-columns
			+input('IMPRINT_EMAIL', 'Email')
			+input('IMPRINT_WEBSITE', 'Website')
		.clear
		.two-columns
			+input('IMPRINT_REGISTRATION', 'Registration')
			+input('IMPRINT_VAT', 'Vat')
		.clear
