include ../../mixins/category-breadcrumb.pug
include ../../mixins/paging.pug

each dataset in data
	if dataset.type !== 'IMPACT_CATEGORY' && dataset.type !== 'NW_SET'
		.file-reference(id=dataset.id)
			- var url = '';
			if dataset.type !== 'CATEGORY'
				- url = baseUrl + '/' + dataset.type + '/' + dataset.refId + '?commitId=' + commitId;				
			else
				- var fullPath = '';
				if dataset.categories && dataset.categories.length
					each category in dataset.categories
						- fullPath += category + '/';
				- fullPath += dataset.name;
				- url = baseUrl + 's/' + getTypeLabel(dataset.categoryType) + '/' + fullPath;
			.header
				a(data-type=dataset.added?'added':dataset.deleted?'deleted':'changed' href=standalone?commitId+'-'+dataset.refId+'.html':url class=standalone?'standalone':null)
					if dataset.added || dataset.deleted
						- var action = dataset.added ? 'add' : 'delete';
						if dataset.type === 'CATEGORY'
							img.model-icon-small(src='images/model/small/overlay/' + action + '/category/' + dataset.categoryType.toLowerCase() + '.png', aria-label='Model icon of ' + dataset.categoryType + ' category ' + action)
						else if dataset.type === 'PROCESS' && dataset.processType
							- var processType = dataset.processType === 'LCI_RESULT' ? 'process_system' : 'process_unit';
							img.model-icon-small(src='images/model/small/overlay/' + action + '/' + processType + '.png', aria-label='Model icon of ' + dataset.processType + ' ' + action)
						else if dataset.type === 'FLOW' && dataset.flowType
							- var flowType = dataset.flowType === 'PRODUCT_FLOW' ? 'flow_product' : dataset.flowType === 'WASTE_FLOW' ? 'flow_waste' : 'flow_elementary';
							img.model-icon-small(src='images/model/small/overlay/' + action + '/' + flowType + '.png', aria-label='Model icon of ' + dataset.flowType + ' ' + action)
						else
							img.model-icon-small(src='images/model/small/overlay/' + action + '/' + dataset.type.toLowerCase() + '.png', aria-label='Model icon of ' + dataset.type + ' ' + action)
					else
						if dataset.type === 'CATEGORY'
							img.model-icon-small(src='images/model/small/category/' + dataset.categoryType.toLowerCase() + '.png', aria-label='Model icon of ' + dataset.categoryType + ' category ')
						else
							img.model-icon-small(src='images/model/small/' + dataset.type.toLowerCase() + '.png', aria-label='Model icon of ' + dataset.type)
					if dataset.deleted
						del=dataset.name
					else
						span=dataset.name
				if dataset.categories && dataset.categories.length
					- var type = dataset.type === 'CATEGORY' ? dataset.categoryType : dataset.type
					- var catUrl = baseUrl + 's/' + getTypeLabel(type);
					+category-breadcrumb(catUrl, dataset.categories, true)
if !standalone
	+paging(resultInfo)