include ../../mixins/user-info.pug
include ../../mixins/forms.pug

.header-box
	h4 
		div=commit.message
		small=commit.id
	+user-info(commit.user, commit.userDisplayName)(class='concealed')
		|  on #{formatDate(commit.timestamp)}
	.pull-right: +select('type', 'Model type', [], '', true)
	.clear
	.form-group
		input#filter.form-control(type='text' placeholder='Filter by name')
.file-references.content-box