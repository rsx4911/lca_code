include ../mixins/category-breadcrumb.pug
include ../mixins/forms.pug

mixin download-dropdown()
	.dropdown.btn-group
		button.btn.btn-success.dropdown-toggle(data-toggle='dropdown' aria-haspopup='true' aria-expanded='false')
			span.glyphicon.glyphicon-download
			span.text Download 
			span.caret
		ul.dropdown-menu
			li: a(href='#' data-format='json') as JSON-LD
			- var type = null;
			if categoryPath && categoryPath.length
				- var type = categoryPath[0]
			- var ilcdAvailable = $.inArray(type, ['Actors', 'Sources', 'Unit groups', 'Flow properties', 'Flows', 'Processes', 'Impact methods']) !== -1;
				li: a(href='#' data-format='ilcd') as ILCD
			li.divider(role='separator')
			li: a(href='#' data-format='json' data-action='select-data') as JSON-LD (Subselect)...
			li: a(href='#' data-format='ilcd' data-action='select-data') as ILCD (Subselect)...

- var showCommitSelection = !isPublic && commits && commits.length;
if showCommitSelection || categoryPath
	.header-box
		if showCommitSelection
			.pull-left
				+select('commit', 'Commit', null, null, true)
					each commit, index in commits
						option(value=commit.id selected=(!commitId&&index===0)||commit.id===commitId)=index===0?'Latest':commit.id 
						optgroup.additional-info(label!='&nbsp; &nbsp;' + commit.message)
			.pull-right
				span.pull-left: +checkbox('show-deleted', 'Show deleted')(checked=showDeleted)
				+download-dropdown()
		.clear
		if categoryPath
			.form-group
				input#filter.form-control.input-lg(type='text' placeholder='Filter by name' aria-label='Filter by name')
			.clear
if !isPublic || pathAsArray
	.header-box
		if deleted
			.pull-left
				+category-breadcrumb(baseUrl, pathAsArray, false, false, commitId)
			.badge.pull-right.deleted Deleted
		else if !showCommitSelection
			.pull-left
				+category-breadcrumb(baseUrl, pathAsArray, false, false, commitId)
			.pull-right
				+download-dropdown()
		else
			+category-breadcrumb(baseUrl, pathAsArray, false, false, commitId)
		.clear

.content-box
	table.table.table-browse
		if !isPublic
			thead
				tr
					th
					th Name
					th Last change
					th Commit
		tbody
	.no-content-message(style='display:none') No data sets found