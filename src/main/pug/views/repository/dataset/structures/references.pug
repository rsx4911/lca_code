include ../../../mixins/paging.pug

each element in data
	div 
		img.model-icon-small(src='images/model/small/' + getIcon(element), aria-label='Model icon of ' + element.type)
		- var query = commitId ? '?commitId=' + commitId : ''
		a(href=baseUrl + '/' + element.type + '/' + element.refId + query)=element.name
+paging(resultInfo, null, pageSizeId)