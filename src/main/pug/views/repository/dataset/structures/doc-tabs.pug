include ../mixins.pug

mixin review-tab(reviews)
	each review in reviews
		p
			strong='Review'
		table.table.no-head
			tbody
				tr
					td='Review type'
					td=review.reviewType
				tr
					td='Review report'
					td
						+ref(review.report)
				tr
					td='Review details'
					td=review.details
				each reviewer in review.reviewers
					tr
						td='Reviewer'
						td
							+ref(reviewer)

		table.table
			thead
				tr
					th='Review scope'
					th='Review method(s)'
			tbody
				each scope in review.scopes
					tr
						td=scope.name
						td
							ul
								each method in scope.methods
									li=method

		table.table
			thead
				tr
					th='Review aspects'
					th='Quality assessment'
			tbody
				each aspect in review.assessment
					tr
						td=aspect.aspect
						td=aspect.value

mixin compliance-tab(declarations)
	each dec in declarations
		p
			strong='Compliance declaration'
		table.table.no-head
			tbody
				tr
					td='Compliance system'
					td
						+ref(dec.system)
				tr
					td='Comment'
					td=dec.comment

		if dec.aspects
			table.table
				thead
					tr
						th='Compliance aspects'
						th='Compliance value'
				tbody
					each aspect in dec.aspects
						tr
							td=aspect.aspect
							td=aspect.value
