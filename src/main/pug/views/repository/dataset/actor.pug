include ./mixins.pug

+menubar
.content-box
	.model-left-content
		+header
		.content
			table.table.no-head
				tbody
					tr
						td=getLabel('address')
						td
							+field-block('address')
							if dataset.zipCode || dataset.city || (compareTo && (compareTo.zipCode || compareTo.city)) || reviewMode
								div 
									+field('zipCode')
									|  
									+field('city')
							+field-block('country')
					+field-row('telephone')
					+field-row('telefax')
					+field-link-row('email')
					+field-link-row('website')
	+meta
	.clear
