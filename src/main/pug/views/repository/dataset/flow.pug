include ./structures/flow-property-table.pug

+menubar
.content-box
	.model-left-content
		+header
		+content
			- var outId = dataset.flowType==='ELEMENTARY_FLOW'?'emittedBy':'producedBy';
			ul.nav.nav-tabs(role='tablist')
				+nav-tab('flowInfo', true, true)
				+nav-tab('flowProperties')
				if isSearchLinksEnabled
					+nav-tab('usedBy', false, true)
					+nav-tab(outId, false, true)
			.tab-content
				+nav-tab-pane('flowInfo', true, true)
					table.table.no-head
						tbody
							- var getFlowTypeLabel = function (flowType) { return getSpecificTypeLabel('FlowType', flowType); };
							+field-row('flowType', getFlowTypeLabel)
							+field-row('cas')
							+field-row('formula')
							+field-row('synonyms')
							+ref-row('location')
							+boolean-field-row('isInfrastructureFlow')
				+nav-tab-pane('flowProperties')
					+flow-property-table()
				if isSearchLinksEnabled
					+nav-tab-pane('usedBy', false, true)
						.form-group
							input#used-by-filter.form-control(type='text' placeholder='Filter by name' aria-label='Filter by name')
						#used-by-data
					+nav-tab-pane(outId, false, true)
						.form-group
							input.form-control(id=outId + '-filter' type='text' placeholder='Filter by name' aria-label='Filter by name')
						div(id=outId + '-data')
	+meta
	.clear