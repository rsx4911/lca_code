include ./mixins.pug

+menubar
.content-box
	.model-left-content
		+header
		.content
			table.table.no-head
				tbody
					- var getParameterType = function(value, parent) { return parent ? (parent.inputParameter ? 'Input' : 'Dependant') : null;};
					+field-row('inputParameter', getParameterType)
					- var getFormula = function (value, parent) { return parent ? (parent.inputParameter ? parent.value : (parent.formula + ' = ' + parent.value)) : null;}; 
					+field-row(dataset.inputParameter?'value':'formula', getFormula)
	+meta
	.clear