include ./structures/product-system-parameter-redef-table.pug
include ./structures/exchange-table.pug
include ./structures/exchange-list.pug

mixin target-amount-row()
	tr
		td=getLabel('targetAmount')
		td
			+field('targetAmount')
			if dataset.targetUnit || getValue(compareTo, targetUnit) || reviewMode
				|  
				+field('targetUnit.name')

+menubar
.content-box
	.model-left-content
		+header
		.content
			- var hasLinks = hasAtLeastOne(dataset, null, 'processLinks');
			ul.nav.nav-tabs(role='tablist')
				+nav-tab(null, true, 'Overview')
				+nav-tab('inventory')
				if dataset.inventory && dataset.inventory.length
					+nav-tab(null, false, 'Impacts')
				if hasLinks && !standalone
					+nav-tab(null, false, 'Supply chain')
					+nav-tab(null, false, 'Graph')
				+nav-tab('parameterRedefs')
				if !standalone
					+maximize-icon
			.tab-content
				+nav-tab-pane('overview', true, true)
					table.table.no-head
						tbody
							+ref-row('referenceProcess')
							if dataset.referenceExchange && dataset.referenceExchange.flow
								+ref-row('referenceExchange.flow')
							else
								- var name = dataset.referenceExchange ? dataset.referenceExchange.name : null;
								- var otherName = compareTo && compareTo.referenceExchange ? compareTo.referenceExchange.name : null;
								if name || otherName || reviewMode
									+field-row-frame('referenceExchange.name')
										+field-row-value(name, otherName)
							+ref-row('targetFlowProperty')
							+target-amount-row()
				+nav-tab-pane('inventory')
					a.pull-right.toggle-control.switch-to-list(href='#') Switch to list view
					.clear
					.exchange-tables.toggleable
						+exchange-table('inventory', true)
						+exchange-table('inventory', false)
					a.pull-right.toggle-control.switch-to-table(href='#') Switch to table view
					.clear
					.exchange-list.toggleable
						+exchange-list(exchangeMap, otherExchangeMap)
				if dataset.inventory && dataset.inventory.length
					+nav-tab-pane('impacts', false, true)
						label Impact method:
						|  
						span.impact-method No selection
						|  
						button.btn.btn-sm.btn-default.select-method Select...
						table.table.impact-result-table.no-sorting(style='display:none;')
							thead
								tr
									th Impact category
									th Result
							tbody
				if !standalone
					+nav-tab-pane('supply-chain', false, hasLinks)
						#process-tree-container
					+nav-tab-pane('graph', false, hasLinks)
						iframe(src='graph/graph.html' width='100%' height='500px')
				+nav-tab-pane('parameterRedefs')
					+product-system-parameter-redef-table()
	+meta
		hr
		strong=getLabel('processes')
		div=dataset.processes?dataset.processes.length:0
		strong=getLabel('processLinks')
		div=dataset.processLinks?dataset.processLinks.length:0
	.clear