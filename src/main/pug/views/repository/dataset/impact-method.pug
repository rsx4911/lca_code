include ./structures/parameter-table.pug
include ./structures/impact-factor-table.pug
include ./structures/nw-factor-table.pug

+menubar
.content-box
	.model-left-content
		+header
		.content
			ul.nav.nav-tabs(role='tablist')
				+nav-dropdown('impactCategories', 'IMPACT_CATEGORY', true)
				+nav-dropdown('nwSets', 'NW_SET')
				+nav-tab('parameters')
			.tab-content
				each values, index in getArrayValues(dataset, compareTo, 'IMPACT_CATEGORY', 'impactCategories')
					- var path = 'impactCategories-' + (values[0] ? values[0].id : values[1].id);
					- var active = index === 0;
					+nav-tab-pane(path, active, true)
						h4
							+sub-field(values[0], values[1], 'name')(data-path=values[0]?'impactCategories[' + values[0].id + ']':null)
							small: +sub-field-block(values[0], values[1], 'description')
						+impact-factor-table(values[0], values[1])
				each values in getArrayValues(dataset, compareTo, 'NW_SET', 'nwSets')
					- var path = 'nwSets-' + (values[0] ? values[0].id : values[1].id);
					- var active = index === 0;
					+nav-tab-pane(path, active, true)
						h4
							+sub-field(values[0], values[1], 'name')(data-path=values[0]?'nwSets[' + values[0].id + ']':null)
							small: +sub-field-block(values[0], values[1], 'weightedScoreUnit')
						+nw-factor-table(values[0], values[1])
				+nav-tab-pane('parameters')
					+parameter-table(true)
					+parameter-table(false)
	+meta
	.clear