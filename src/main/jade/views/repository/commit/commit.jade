include ../../mixins/user-info.jade
include ../../mixins/forms.jade

.header-box
	h4 
		div #{commit.message}
		small #{commit.id}
	+user-info(commit.user, commit.userDisplayName)(class='concealed')
		|  on #{formatDate(commit.timestamp)}
	.pull-right: +select('type', 'Model type', [], '', true)
	.clear
	.form-group
		input#filter.form-control.input-lg(type='text' placeholder='Filter by name')
.file-references.content-box