include ../../mixins/paging.jade

mixin entry-label(dataset)
	.header
		if dataset.type === 'CATEGORY'
			img.model-icon-small(src='images/model/small/category/#{dataset.categoryType.toLowerCase()}.png')
		else
			img.model-icon-small(src='images/model/small/#{dataset.type.toLowerCase()}.png')
		if dataset.deleted
			del=dataset.fullPath
		else
			span=dataset.fullPath


each dataset in data
	if dataset.type !== 'IMPACT_CATEGORY' && dataset.type !== 'NW_SET'
		.file-reference(id=dataset.id)
			if dataset.deleted && dataset.type === 'CATEGORY'
				+entry-label(dataset)
			else
				- var url = baseUrl + '/' + dataset.type + '/' + dataset.refId + '/' + commitId;
				if dataset.type === 'CATEGORY'
					- url = baseUrl + 's/' + getTypeLabel(dataset.categoryType) + '/' + dataset.fullPath;
				a(href=url): +entry-label(dataset)

+paging(resultInfo)