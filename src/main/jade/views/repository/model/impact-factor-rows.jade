include mixins.jade

each factor in impactCategory.impactFactors
	tr
		td=factor.flow.name
		td
			if factor.flow.category
				- var path = factor.flow.category.split('/');
				| #{path[path.length - 1]}
				if path.length > 1
					|  / #{path[path.length - 2]}			
		td 
			- var unit = impactCategory.referenceUnitName + '/' + factor.unit.name;
			if factor.formula && (isNaN(factor.formula) || parseFloat(factor.formula) !== factor.value)
				| #{factor.formula} #{unit} = 
			| #{factor.value} #{unit}
		td: +uncertainty(factor.uncertainty)
