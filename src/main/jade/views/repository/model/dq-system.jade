include ./mixins.jade

+menubar
.content-box
	.model-left-content
		+header
		.content
			+data-quality-matrix(dataset, false)
			if dataset.hasUncertainties
				hr
				h4 Uncertainties
				+data-quality-matrix(dataset, true)
	+meta
		hr
		strong Source
		div: +ref(dataset.source, null, false, '-')
	.clear