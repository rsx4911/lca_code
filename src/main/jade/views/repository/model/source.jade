include ./mixins.jade

+menubar
.content-box
	.model-left-content
		+header
		.content
			table.table.no-head
				tbody
					+field-row('DOI', dataset.doi, true)
					+field-row('Text reference', dataset.textReference, true)
					+field-row('Year', dataset.year, true)
					if dataset.externalFile
						+field-row('Year')
							a(href='#{fileBaseUrl}/#{dataset.externalFile}' target='_blank')=dataset.externalFile
	+meta
	.clear