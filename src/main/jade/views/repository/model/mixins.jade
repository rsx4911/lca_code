include ../../mixins/forms.jade
include ../../mixins/user-info.jade

mixin menubar()
	.header-box
		- var currentCommit = null;
		+select('commitId', 'Version', null, null, true)
			each commit, i in commits
				if commit.id === commitId
					- currentCommit = commit;
				option(value=commit.id selected=commit.id===commitId)=i===0?'Latest':commit.id 
				optgroup.additional-info(label!='&nbsp; &nbsp;#{formatCommitDescription(commit.message)}')
		a.btn.btn-success.pull-right(href=downloadUrl download='#{dataset.id}.json')
			span.glyphicon.glyphicon-download
			span.text Download Raw Data
		.clear
		+user-info(currentCommit.user, currentCommit.userDisplayName)(class='concealed')
			|  on #{formatDate(currentCommit.timestamp)}

mixin header()
	h3.title
		img.pull-right.model-icon(src='/images/model/large/#{getIcon(dataset)}')
		div=dataset.name
		small
			span=dataset.description
	.clear.content
		if dataset.category
			a(href='#{baseUrl}s/#{dataset.category.id}')
				| #{dataset.category.name}
	block
	hr

mixin meta() 
	.model-right-content.content-box
		.meta-info
			div
				strong Version
				div=dataset.version
			div
				strong Last change
				div 
					if dataset.lastChange
						| #{formatDate(dataset.lastChange)}
					else
						| -
			div
				strong UUID
				div=dataset.id
			block

mixin field-row(label, value, checkValue, formatter)
	if !checkValue || value
		tr
			td=label
			td #{value?formatter?formatter(value):value:''}
				block

mixin ref(ref, additionalTypeInfo, noImage)
	if ref
		if !noImage
			img.model-icon-small(src='/images/model/small/#{getIcon(ref, additionalTypeInfo)}')
		a(href='#{baseUrl}/#{getTypeAsEnum(ref.type)}/#{ref.id}')=ref.name

mixin ref-row(label, ref, additionalTypeInfo)
	if ref
		tr
			td=label
			td: +ref(ref, additionalTypeInfo)

mixin exchange-row(exchange)
	tr(class=exchange.quantitativeReference?'reference':null)
		td: img.icon-small(src='/images/' + (exchange.input?'input':'output') + '.png')
		td: +ref(exchange.flow)
		td 
			if exchange.flow.category
				- var path = exchange.flow.category.name.split('/');
				| #{path[path.length - 1]}
				if path.length > 1
					|  / #{path[path.length - 2]}
		td #{exchange.amount}
			if exchange.unit 
				|  #{exchange.unit.name}
		td 
			if exchange.costValue
				| #{exchange.costValue} #{exchange.currency.name}
		td: +uncertainty(exchange.uncertainty)
		td
			if exchange.input
				+ref(exchange.defaultProvider)
			else
				if exchange.avoidedProduct
					img.icon-small(src='/images/check_true.png')

mixin exchange-table(exchanges, input)
	table.table(class=input?'inputs':'outputs')
		thead
			tr
				th
				th Flow
				th Category
				th Amount
				th Costs
				th Uncertainty
				th #{input?'Provider':'Avoided product'}
		tbody
			each exchange in exchanges
				if exchange.input === input
					+exchange-row(exchange)

mixin non-causal-allocation-table(factors)
	h4 Physical & Economic allocation
	table.table.allocation-factors
		thead
			tr
				th
				th Product
				th Physical
				th Economic
		tbody
			each factor in factors
				tr
					td
					td: +ref(factor.product)
					td=factor.physical
					td=factor.economic

mixin causal-allocation-table(factors)
	if factors.length
		h4 Causal allocation
		table.table.allocation-factors
			thead
				tr
					th
					th Flow
					each product in factors[0].products
						th: +ref(product.product)
			tbody
				each factor in factors
					tr
						td: img.icon-small(src='/images/' + (factor.exchange.input?'input':'output') + '.png')
						td: +ref(factor.exchange.flow)
						each product in factor.products
							td=product.value

mixin uncertainty(uncertainty)
	if uncertainty
		if uncertainty.distributionType === 'LOG_NORMAL_DISTRIBUTION'
			| Normal distribution (Geom. mean: #{uncertainty.geomMean}, Geom. SD: #{uncertainty.geomSd})
		else if uncertainty.distributionType === 'NORMAL_DISTRIBUTION'
			| Normal distribution (Mean: #{uncertainty.mean}, SD: #{uncertainty.sd})
		else if uncertainty.distributionType === 'TRIANGLE_DISTRIBUTION'
			| Triangle distribution (Min: #{uncertainty.minimum}, Mode: #{uncertainty.mode}, Max: #{uncertainty.maximum})
		else if uncertainty.distributionType === 'UNIFORM_DISTRIBUTION'
			| Uniform distribution (Min: #{uncertainty.minimum}, Max: #{uncertainty.maximum})
		else
			| No distribution
	else
		| No distribution

mixin parameter-table(parameters, input)
	- var isEmpty = true;
	each parameter in parameters
		if parameter.inputParameter === input
			- isEmpty = false
	if !isEmpty
		h4 #{input?'Input parameters':'Dependant parameters'}
		table.table.table-parameters
			thead
				tr
					th Parameter
					th Description
					if input
						th Uncertainty
			tbody
				each parameter in parameters
					if parameter.inputParameter === input
						tr
							td
								| #{parameter.name}
								unless input
									|  = #{parameter.formula}
								|  = #{parameter.value}
							td=parameter.description
							if input
								td
									+uncertainty(parameter.uncertainty)

mixin parameter-redef-table(parameters)
	table.table
		thead
			tr
				th Context
				th Name
				th Value
				th Uncertainty
		tbody
			each parameter in parameters
				tr
					td 
						if parameter.context
							+ref(parameter.context)
						else
							| Global
					td=parameter.name
					td=parameter.value
					td 
						if parameter.inputParameter
							+uncertainty(parameter.uncertainty)

