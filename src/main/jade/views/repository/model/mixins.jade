include ../../mixins/forms.jade
include ../../mixins/user-info.jade

mixin menubar()
	.header-box
		- var currentCommit = null;
		+select('commitId', 'Version', null, null, true)
			each commit, i in commits
				if commit.id === commitId
					- currentCommit = commit;
				option(value=commit.id selected=commit.id===commitId)=i===0?'Latest':commit.id 
				optgroup.additional-info(label!='&nbsp; &nbsp;#{formatCommitDescription(commit.message)}')
		button.btn.btn-success.pull-right(data-action='download-data')
			span.glyphicon.glyphicon-download
			span.text Download
		.clear
		+user-info(currentCommit.user, currentCommit.userDisplayName)(class='concealed')
			|  on #{formatDate(currentCommit.timestamp)}

mixin header()
	.title
		img.pull-right.model-icon(src='/images/model/large/#{getIcon(dataset)}')
		div
			h3=dataset.name
			.category
				if dataset.category
					| #{dataset.category.name}
			h3: small: span=dataset.description
	block
	hr

mixin meta() 
	.model-right-content.content-box
		.meta-info
			div
				strong Version
				div=dataset.version
			div
				strong Last change
				div 
					if dataset.lastChange
						| #{formatDate(dataset.lastChange)}
					else
						| -
			div
				strong UUID
				div=dataset.id
			block

mixin field-row(label, value, checkValue, formatter)
	if !checkValue || value
		tr
			td=label
			td #{value?formatter?formatter(value):value:''}
				block

mixin ref(ref, additionalTypeInfo, noImage, defaultLabel)
	if ref
		if !noImage
			img.model-icon-small(src='/images/model/small/#{getIcon(ref, additionalTypeInfo)}')
		if commitId
			a(href='#{baseUrl}/#{getTypeAsEnum(ref.type)}/#{ref.id}/#{commitId}')=ref.name
		else
			a(href='#{baseUrl}/#{getTypeAsEnum(ref.type)}/#{ref.id}')=ref.name
	else if defaultLabel
		| #{defaultLabel}

mixin ref-row(label, ref, additionalTypeInfo, noImage)
	if ref
		tr
			td=label
			td: +ref(ref, additionalTypeInfo, noImage)

mixin uncertainty(uncertainty, round)
	if uncertainty
		if uncertainty.distributionType === 'LOG_NORMAL_DISTRIBUTION'
			| Lognormal distribution
			br
			| Geom. mean: #{noToStr(uncertainty.geomMean, round)}
			br
			| Geom. SD: #{noToStr(uncertainty.geomSd, round)}
		else if uncertainty.distributionType === 'NORMAL_DISTRIBUTION'
			| Normal distribution 
			br
			| Mean: #{noToStr(uncertainty.mean, round)} 
			br
			| SD: #{noToStr(uncertainty.sd, round)}
		else if uncertainty.distributionType === 'TRIANGLE_DISTRIBUTION'
			| Triangle distribution
			br
			| Min: #{noToStr(uncertainty.minimum, round)}
			br
			| Mode: #{noToStr(uncertainty.mode, round)}
			br
			| Max: #{noToStruncertainty.maximum, round)}
		else if uncertainty.distributionType === 'UNIFORM_DISTRIBUTION'
			| Uniform distribution 
			br
			| Min: #{noToStr(uncertainty.minimum, round)}
			br
			| Max: #{noToStr(uncertainty.maximum, round)}
		else
			| No distribution
	else
		| No distribution

mixin parameter-table(parameters, input)
	- var isEmpty = true;
	each parameter in parameters
		if parameter.inputParameter === input
			- isEmpty = false
	if !isEmpty
		h4 #{input?'Input parameters':'Dependant parameters'}
		table.table.table-parameters
			thead
				tr
					th Parameter
					th Description
					if input
						th Uncertainty
			tbody
				each parameter in parameters
					if parameter.inputParameter === input
						tr
							td
								| #{parameter.name}
								unless input
									|  = #{parameter.formula}
								|  = #{parameter.value}
							td=parameter.description
							if input
								td
									+uncertainty(parameter.uncertainty)

mixin parameter-redef-table(parameters)
	table.table
		thead
			tr
				th Context
				th Name
				th Value
				th Uncertainty
		tbody
			each parameter in parameters
				tr
					td 
						if parameter.context
							+ref(parameter.context)
						else
							| Global
					td=parameter.name
					td=parameter.value
					td 
						if parameter.inputParameter
							+uncertainty(parameter.uncertainty)

mixin data-quality-matrix(system, uncertainties, entries)
	if system.indicators && system.indicators.length
		- clazz = ''
		if uncertainties
			- clazz += 'uncertainties'
		else if entries
			- clazz += 'center-inline'
		table.data-quality.no-head(class=clazz?clazz:null)
			thead
				tr
					th
					each score in system.indicators[0].scores
						th=score.label?score.label:score.position
			tbody
				each indicator in system.indicators
					tr
						td=indicator.name?indicator.name:indicator.position
						each score in indicator.scores
							if uncertainties
								td=score.uncertainty
							else
								td(style='background-color:#{getDQColor(system, indicator, score, entries)}' data-indicator=indicator.position data-score=score.position): span=score.description

