include ./mixins.jade

+menubar
.content-box
	.model-left-content
		+header
		.content
			table.table.no-head
				tbody
					+field-row('Type', getLabel('FlowType', dataset.flowType))
					+field-row('CAS number', dataset.casNumber, true)
					+field-row('Formula', dataset.formula, true)
					if dataset.synonyms && dataset.synonyms.length
						+field-row('Synonyms')
							.comma-separated
								each synonym in dataset.synonyms
									span=synonym
					+ref-row('Location', dataset.location)
					+field-row('Infrastructure flow')
						img.icon-small(src='/images/check_' + (dataset.infrastructureFlow?'true':'false') + '.png')
			if dataset.flowProperties
				h4 Flow properties
				table.table.flow-properties
					thead
						tr
							th Name
							th Formula
					tbody
						- var referenceFactor = null;
						each factor in dataset.flowProperties
							if factor.referenceFlowProperty
								- referenceFactor = factor
						each factor in dataset.flowProperties
							if factor.flowProperty
								tr(class=factor.referenceFlowProperty?'reference':null)
									td: +ref(factor.flowProperty)
									td 1 #{referenceFactor.referenceUnit} = #{factor.conversionFactor} #{factor.referenceUnit}
	+meta
	.clear