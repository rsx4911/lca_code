include ./mixins.jade

+menubar
.content-box
	.model-left-content
		+header
		.content
			ul.nav.nav-tabs(role='tablist')
				li.active(role='presentation') 
					a(href='#overview' aria-controls='overview' role='tab' data-toggle='tab') Overview
				li(role='presentation') 
					a(href='#parameters' aria-controls='parameters' role='tab' data-toggle='tab') Parameters
			.tab-content
				#overview.tab-pane.active(role='tabpanel')
					table.table.no-head
						tbody
							+ref-row('Reference process', dataset.referenceProcess)
							if dataset.referenceExchange
								+ref-row('Reference product', dataset.referenceExchange.flow, 'PRODUCT_FLOW')
							+ref-row('Reference process', dataset.targetFlowProperty)
							if dataset.targetUnit
								+field-row('Target unit', dataset.targetUnit.name)
							+field-row('Target amount', dataset.targetAmount, true)
				if dataset.parameterRedefs && dataset.parameterRedefs.length
					#parameters.tab-pane(role='tabpanel')
						+parameter-redef-table(dataset.parameterRedefs)
	+meta
	.clear