include ../mixins/forms.jade

.header-box Info
	if canDelete
		button.btn.btn-lg.btn-danger.pull-right(data-action='delete-repository') Delete
.content-box
	+static('name', 'Name', repository.name)
	+static('group', 'Group', repository.group)
.header-box Avatar
	img.pull-right.avatar(src='/ws/repository/avatar/#{repository.group}/#{repository.name}')
form#avatar-form.content-box
	#avatar-general-message-group.alert(role='alert'): span.message
	+input('avatar', null, 'file')
	button.btn.btn-lg.btn-success.pull-right(data-action='save-avatar') Save
	.clear