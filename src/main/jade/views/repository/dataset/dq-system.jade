include ./mixins.jade

+menubar
.content-box
	.model-left-content
		+header
		.content
			h4(data-path='indicators') Indicators
			+data-quality-matrix(dataset, false)
			if dataset.hasUncertainties
				hr
				h4 Uncertainties
				+data-quality-matrix(dataset, true)
	+meta
		hr
		strong Source
		div: +ref('source', null, false, '-')
	.clear