include ./mixins.jade
include ./process-tables.jade
include ./process-exchange-list.jade
include ../../mixins/category-breadcrumb.jade
include ../../mixins/long-text.jade

mixin local-field(path, formatter, defaultValue, cropLongText)
	strong=getLabel(path)
	- var value = getValue(dataset, path);
	if !value && defaultValue
		- value = defaultValue
	else if formatter
		- value = formatter(value);
	div(data-path=path)
		if cropLongText 
			+long-text(value)
		else 
			| #{value}

mixin local-ref(path)
	strong=getLabel(path)
	div: +ref(path, null, false, '-')

- var doc = dataset.processDocumentation
+menubar
.content-box
	.model-left-content
		+header
		.content
			ul.nav.nav-tabs(role='tablist')
				li.active(role='presentation') 
					a(href='#exchanges' aria-controls='exchange' role='tab' data-toggle='tab' data-path='exchanges')=getLabel('exchanges')
				if doc || reviewMode
					li(role='presentation') 
						a(href='#documentation' aria-controls='documentation' role='tab' data-toggle='tab')=getLabel('documentation')
				if (dataset.nonCausalAllocationFactors && dataset.nonCausalAllocationFactors.length) || (dataset.causalAllocationFactors && dataset.causalAllocationFactors.length) || reviewMode
					li(role='presentation') 
						a(href='#allocation' aria-controls='allocation' role='tab' data-toggle='tab' data-path='allocationFactors')=getLabel('allocationFactors')
				if (dataset.socialAspects && dataset.socialAspects.length) || reviewMode
					li(role='presentation') 
						a(href='#social' aria-controls='social' role='tab' data-toggle='tab' data-path='socialAspects')=getLabel('socialAspects')
				if (dataset.parameters && dataset.parameters.length) || reviewMode
					li(role='presentation') 
						a(href='#parameters' aria-controls='parameters' role='tab' data-toggle='tab' data-path='parameters')=getLabel('parameters')
			.tab-content
				#exchanges.tab-pane.active(role='tabpanel')
					if dataset.exchanges
						a.pull-right.toggle-control.switch-to-list(href='#') Switch to list view
						.clear
						.exchange-tables.toggleable
							+exchange-table(true)
							+exchange-table(false)
						a.pull-right.toggle-control.switch-to-table(href='#') Switch to table view
						.clear
						.exchange-list.toggleable
							+exchange-list(exchangeMap)
				if doc || reviewMode
					#documentation.tab-pane(role='tabpanel')
						table.table.no-head
							tbody
								+field-row('processDocumentation.intendedApplication', true, true)
								+ref-row('processDocumentation.dataSetOwner')
								+ref-row('processDocumentation.dataGenerator')
								+ref-row('processDocumentation.dataDocumentor')
								+ref-row('processDocumentation.publication')
								+ref-row('processDocumentation.reviewer')
								+field-row('processDocumentation.reviewDetails', true, true)
								+field-row('processDocumentation.restrictionsDescription', true, true)
								+field-row('processDocumentation.projectDescription', true, true)
								+field-row('processDocumentation.creationDate', true, true, formatDate)
								+field-row('copyright')
									span
										img.icon-small(src='images/check_' + (dataset.copyright?'true':'false') + '.png')
								+field-row('processDocumentation.inventoryMethodDescription', true, true)
								+field-row('processDocumentation.modelingConstantsDescription', true, true)
								+field-row('processDocumentation.completenessDescription', true, true)
								+field-row('processDocumentation.dataSelectionDescription', true, true)
								+field-row('processDocumentation.dataTreatmentDescription', true, true)
								+field-row('processDocumentation.samplingDescription', true, true)
								+field-row('processDocumentation.dataCollectionDescription', true, true)
								if (doc && doc.sources) || reviewMode
									+field-row('sources')
										span
											if doc && doc.sources
												each source, index in doc.sources
													div: +ref('processDocumentation.sources[' + index + ']')
				if (dataset.nonCausalAllocationFactors && dataset.nonCausalAllocationFactors.length) || (dataset.causalAllocationFactors && dataset.causalAllocationFactors) || reviewMode
					#allocation.tab-pane(role='tabpanel')
						if (dataset.nonCausalAllocationFactors && dataset.nonCausalAllocationFactors.length)
							+non-causal-allocation-table()
						if (dataset.causalAllocationFactors && dataset.causalAllocationFactors.length)
							+causal-allocation-table()
				if (dataset.socialAspects && dataset.socialAspects.length) || reviewMode
					#social.tab-pane(role='tabpanel')
						if (dataset.socialAspects && dataset.socialAspects.length)
							+social-aspect-table()
				if (dataset.parameters && dataset.parameters.length) || reviewMode
					#parameters.tab-pane(role='tabpanel')
						+parameter-table('parameters', true)
						+parameter-table('parameters', false)
	+meta
		hr
		strong=getLabel('quantitativeReference')
		div
			- var flow = null;
			- var eIndex = -1;
			if dataset.exchanges
				each exchange, index in dataset.exchanges
					if exchange.quantitativeReference
						- flow = exchange.flow;
						- eIndex = index;
			+ref('exchanges[' + eIndex + '].flow', flow?flow.flowType:null, false, '-', true)
		+local-ref('location')
		hr
		+local-field('processDocumentation.validFrom', formatDate, '-')
		+local-field('processDocumentation.validUntil', formatDate, '-')
		hr
		+local-field('processDocumentation.timeDescription', null, '-', true)
		+local-field('processDocumentation.geographyDescription', null, '-', true)
		+local-field('processDocumentation.technologyDescription', null, '-', true)
		hr
		+local-ref('dqSystem')
		+local-ref('exchangeDqSystem')
		+local-ref('socialDqSystem')
		strong=getLabel('dqEntry')
		div
			if dataset.dqEntry
				if dataset.dqSystem
					a(href='#' data-action='show-data-quality' data-entry=dataset.dqEntry data-schema=dataset.dqSystem.id data-path='dqEntry')=dataset.dqEntry
				else
					span(data-path='dqEntry')=dataset.dqEntry
			else
				span(data-path='dqEntry') -
	.clear