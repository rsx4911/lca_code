include ./mixins.jade

+menubar
.content-box
	.model-left-content
		+header
		.content
			table.table.no-head
				tbody
					- var getParameterType = function (isInput) { type ? 'Input' : 'Dependant' };
					+field-row('Type', 'inputParameter', false, getParameterType)
					+field-row('Formula')
						- var formula = dataset.name + ' = ';
						- formula += dataset.inputParameter ? dataset.value : (dataset.formula + ' = ' + dataset.value)
						span(data-path=dataset.inputParameter?'value':'formula')=formula
	+meta
	.clear