include ./mixins.jade

+menubar
.content-box
	.model-left-content
		+header
		.content
			table.table.no-head
				tbody
					- var getParameterType = function (isInput) { return isInput ? 'Input' : 'Dependant'; };
					+field-row('inputParameter', true, false, getParameterType, true)
					+field-row(dataset.inputParameter?'value':'formula', false, false, null, false, true)
						- var formula = dataset.inputParameter ? dataset.value : (dataset.formula + ' = ' + dataset.value)
						span=formula
	+meta
	.clear