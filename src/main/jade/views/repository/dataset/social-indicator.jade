include ./mixins.jade

+menubar
.content-box
	.model-left-content
		+header
		.content
			table.table.no-head
				tbody
					+field-row('Unit of measurement', 'unitOfMeasurement', true)
					+field-row('Evaluation scheme', 'evaluationScheme', true)
					+field-row('Activity variable', 'activityVariable', true)
					+ref-row('Activity quantity', 'activityQuantity')
					if dataset.activityUnit || reviewMode
						+field-row('Activity unit', 'activityUnit.name')
	+meta
	.clear