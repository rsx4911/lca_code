include ./mixins.jade

+menubar
.content-box
	.model-left-content
		+header
		.content
			table.table.no-head
				tbody
					+field-row('unitOfMeasurement', true, true)
					+field-row('evaluationScheme', true, true)
					+field-row('activityVariable', true, true)
					+ref-row('activityQuantity')
					if dataset.activityUnit || reviewMode
						+field-row('activityUnit.name', true, true)
	+meta
	.clear