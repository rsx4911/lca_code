mixin exchange-table(input)
	div
		- var count = 0;
		table.table(class=input?'inputs':'outputs')
			- var show = {costs: false, uncertainty: false, dqEntry: false, defaultProvider: false, avoidedProduct: false};
			each exchange, index in dataset.exchanges
				if exchange.input === input
					if exchange.costValue || exchange.currency
						- show.costs = true;
					if exchange.dqEntry
						- show.dqEntry = true;
					if exchange.uncertainty
						- show.uncertainty = true;
					if input && exchange.defaultProvider
						- show.defaultProvider = true;
					if !input && exchange.avoidedProduct
						- show.avoidedProduct = true;
			thead
				tr
					th
					th=getLabel('exchanges.flow')
					th=getLabel('exchanges.flow.category')
					th=getLabel('exchanges.amount')
					th
						if show.costs
							| #{getLabel('exchanges.costs')}
					th
						if show.uncertainty
							| #{getLabel('exchanges.uncertainty')}
					th
						if show.dqEntry
							| #{getLabel('exchanges.dqEntry')}
					th
						if input && show.defaultProvider
							| #{getLabel('exchanges.defaultProvider')}
						else if show.avoidedProduct
							| #{getLabel('exchanges.avoidedProduct')}
					th
			tbody
				each exchange, index in dataset.exchanges
					if exchange.input === input
						+exchange-row(exchange, index, count)
						- count++;
		if count > 10
			a.toggle-control(href='#') Show #{count - 10} more
			a.toggle-control(href='#' style='display:none') Show less
			if input
				p &nbsp;

mixin exchange-row(exchange, index, count)
	- var clazz = exchange.quantitativeReference?'reference':'';
	- var style = null;
	if count >= 10
		if clazz
			- clazz += ' ';
		- clazz += 'toggleable';
		- style = 'display:none';
	tr(class=clazz?clazz:null style=style)
		td: img.icon-small(src='images/' + (exchange.input?'input':'output') + '.png')
		td: +ref('exchanges[' + index + '].flow', null, false, null, true)
		td 
			if exchange.flow.category
				- var url = baseUrl + 's/Flows';
				+category-breadcrumb(url, exchange.flow.category, true, 2)
		td(title=exchange.amount) #{formatScientific(exchange.amount)}
			if exchange.unit
				|  #{exchange.unit.name}
		td(title=exchange.costValue) #{formatScientific(exchange.costValue)}
			if exchange.currency
				|  #{exchange.currency.name}
		td: +uncertainty(exchange.uncertainty, true)
		td
			if exchange.dqEntry
				if dataset.exchangeDqSystem
					a(href='#' data-action='show-data-quality' data-entry=exchange.dqEntry data-schema=dataset.exchangeDqSystem.id)=exchange.dqEntry
				else
					| #{exchange.dqEntry}
		td
			if exchange.input
				+ref('exchanges[' + index + '].defaultProvider', null, false, null, true)
			else if exchange.avoidedProduct
				img.icon-small(src='images/check_true.png')
		td(data-path='exchanges[' + index +']')

mixin non-causal-allocation-table()
	h4 Physical & Economic allocation
	table.table.allocation-factors
		thead
			tr
				th
				th=getLabel('allocationFactors.product')
				th=getLabel('allocationFactors.physical')
				th=getLabel('allocationFactors.economic')
				td
		tbody
			each factor in dataset.nonCausalAllocationFactors
				if (factor.index || factor.index === 0) && factor.physical && factor.economic
					tr
						td
						td: +ref('allocationFactors[' + factor.index + '].product', 'PRODUCT_FLOW', false, null, true)
						td=factor.physical.value
						td=factor.economic.value
						td(data-path='allocationFactors[' + factor.index + ']')

mixin causal-allocation-table()
	h4 Causal allocation
	table.table.allocation-factors
		thead
			tr
				th
				th=getLabel('allocationFactors.product')
				each product in dataset.causalAllocationFactors[0].products
					th: +ref('allocationFactors[' + product.index + ']', 'PRODUCT_FLOW')
		tbody
			each factor in dataset.causalAllocationFactors
				if factor.exchange && factor.products && factor.products.length && factor.exchange.flow
					tr
						td: img.icon-small(src='images/' + (factor.exchange.input?'input':'output') + '.png')
						td: +ref('allocationFactors[' + factor.products[0].index + '].exchange.flow', factor.exchange.flow.flowType, false, null, true)
						each product in factor.products
							if product.index || product.index === 0
								td=product.value

mixin social-aspect-table()
		table.table.social-aspects
			thead
				tr
					th=getLabel('socialAspects.socialIndicator.name')
					th=getLabel('socialAspects.rawValue')
					th=getLabel('socialAspects.riskLevel')
					th=getLabel('socialAspects.acitivityVariable')
					th=getLabel('socialAspects.quality')
					th=getLabel('socialAspects.comment')
					th=getLabel('socialAspects.source')
					th
			tbody
				each aspect, index in dataset.socialAspects
					tr
						td: +ref('socialAspects[' + index + '].socialIndicator', null, false, null, true)
						td #{aspect.rawAmount}
							if aspect.socialIndicator.unitOfMeasurement
								|  [#{aspect.socialIndicator.unitOfMeasurement}]
						td(data-path='socialAspects[' + index + '].riskLevel')=aspect.riskLevel
						td #{aspect.activityValue}
							if aspect.socialIndicator.activityUnit && aspect.socialIndicator.activityVariable
								|  #{aspect.socialIndicator.activityUnit.name}, #{aspect.socialIndicator.activityVariable}
						td
							if aspect.quality
								if dataset.socialDqSystem
									a(href='#' data-action='show-data-quality' data-entry=aspect.quality data-schema=dataset.socialDqSystem.id)=aspect.quality
								else
									| #{aspect.quality}
						td=aspect.comment
						td: +ref('socialAspects[' + index + '].source', null, false, null, true)
						td(data-path='socialAspects[' + index + ']')
