include ./mixins.jade

+menubar
.content-box
	.model-left-content
		+header
		.content
			table.table.no-head
				tbody
					+field-row('Address')
						if dataset.address
							div(data-path='address')=dataset.address
						if dataset.zipCode || dataset.city || reviewMode
							div 
								span(data-path='zipCode')=dataset.zipCode
								|  
								span(data-path='city')=dataset.city 
						if dataset.country || reviewMode
							div(data-path='country') #{dataset.country}
					+field-row('Phone', 'telephone', true)
					+field-row('Fax', 'telefax', true)
					if dataset.email || reviewMode
						+field-row('Email')
							span(data-path='email')
								if dataset.email
									a(href='mailto:#{dataset.email}' data-protocol='mailto')=dataset.email
					if dataset.website || reviewMode
						+field-row('Website')
							span(data-path='website')
								if dataset.website
									a(href=dataset.website target='_blank')=dataset.website
	+meta
	.clear