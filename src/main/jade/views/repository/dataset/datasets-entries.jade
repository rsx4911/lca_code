if categoryPath
	- var path = categoryPath.substring(0, categoryPath.lastIndexOf('/'));
	- var previousUrl = baseUrl + '/datasets';
	if path
		- previousUrl += '/' + path;
	tr 
		td 
		td: a(href=previousUrl): strong ..
		td
		td
each entry in entries
	tr
		if !categoryPath
			td: img.model-icon-small(src='images/model/small/category/#{entry.type.toLowerCase()}.png')
			td: a(href='#{baseUrl}/datasets/#{getRootLabel(entry.type)}'): strong 
				if entry.deleted
					del  #{getRootLabel(entry.type)}
				else
					|  #{getRootLabel(entry.type)}
			td
			td
		else
			- var icon = null;
			if entry.type === 'CATEGORY'
				- icon = 'category/' + entry.categoryType.toLowerCase();
			else
				- icon = entry.type.toLowerCase();
				if entry.type === 'FLOW' && entry.flowType
					- icon += '_' + entry.flowType.substring(0, entry.flowType.indexOf('_'));
				else if entry.type === 'PROCESS' && entry.processType === 'LCI_RESULT'
					- icon += '_system'
			td: img.model-icon-small(src='images/model/small/#{icon}.png')
			td
				- var url = entry.type === 'CATEGORY' ? '/datasets/' + categoryPath + '/' + entry.name : '/dataset/' + entry.type + '/' + entry.refId;
				if commitId
					- url += '?commitId=' + commitId
				a(href=baseUrl + url): strong
					if entry.action === 'DELETE'
						del #{entry.name}
					else
						| #{entry.name}
			td #{formatLastUpdate(entry.lastUpdate)}
			td: a(href='#{baseUrl}/commit/#{entry.commitId}') #{entry.commitMessage}
