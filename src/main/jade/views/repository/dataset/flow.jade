include ./structures/flow-property-table.jade

+menubar
.content-box
	.model-left-content
		+header
		.content
			- var outLabel = dataset.flowType==='ELEMENTARY_FLOW'?'Emitted by':'Produced by';
			- var outId = dataset.flowType==='ELEMENTARY_FLOW'?'emitted-by':'produced-by';
			ul.nav.nav-tabs(role='tablist')
				+nav-tab(null, true, 'Flow info')
				+nav-tab('flowProperties')
				+nav-tab(null, false, 'Used by')
				+nav-tab(null, false, outLabel)
			.tab-content
				+nav-tab-pane('flow-info', true, true)
					table.table.no-head
						tbody
							- var getFlowTypeLabel = function (flowType) { return getSpecificTypeLabel('FlowType', flowType); };
							+field-row('flowType', getFlowTypeLabel)
							+field-row('cas')
							+field-row('formula')
							+field-row('synonyms')
							+ref-row('location')
							+boolean-field-row('infrastructureFlow')
				+nav-tab-pane('flowProperties')
					+flow-property-table()
				+nav-tab-pane('used-by', false, true)
					.form-group
						input#used-by-filter.form-control(type='text' placeholder='Filter by name')
					#used-by-data
				+nav-tab-pane(outId, false, true)
					.form-group
						input.form-control(id=outId + '-filter' type='text' placeholder='Filter by name')
					div(id=outId + '-data')
	+meta
	.clear