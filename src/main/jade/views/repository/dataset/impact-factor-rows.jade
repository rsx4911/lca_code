include mixins.jade

if impactCategory.impactFactors
	each factor, index in impactCategory.impactFactors
		- var hasFormula = factor.formula && (isNaN(factor.formula) || parseFloat(factor.formula) !== factor.value);
		tr
			td(data-path='factors[' + index + '].flow')=factor.flow.name
			td
				if factor.flow.category
					- var path = factor.flow.category.split('/');
					| #{path[path.length - 1]}
					if path.length > 1
						|  / #{path[path.length - 2]}			
			td 
				- var unit = impactCategory.referenceUnitName + '/' + factor.unit.name;
				if hasFormula
					| #{factor.formula} #{unit} = 
				span(data-path='factors[' + index + '].' + (hasFormula ? 'formula' : 'value'))=factor.value
				|  
				span(data-path='factors[' + index + '].unit')=unit
			td(data-path='factors[' + index + '].uncertainty'): +uncertainty(factor.uncertainty)
