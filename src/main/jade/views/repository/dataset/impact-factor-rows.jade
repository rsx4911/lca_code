include mixins.jade

if dataset.impactFactors
	each factor, index in dataset.impactFactors
		- var hasFormula = factor.formula && (isNaN(factor.formula) || parseFloat(factor.formula) !== factor.value);
		tr
			td: +ref('impactFactors[' + index + '].flow')
			td
				if factor.flow.category
					- var url = baseUrl + 's/Flows';
					+category-breadcrumb(url, factor.flow.category, true, 2)
			td 
				- var unit = dataset.referenceUnitName + '/' + factor.unit.name;
				if hasFormula
					| #{factor.formula} #{unit} = 
				span #{factor.value} #{unit}
			td: +uncertainty(factor.uncertainty)
			td(data-path='impactCategories[' + dataset.id + '].impactFactors[' + factor.flow.id + ']')