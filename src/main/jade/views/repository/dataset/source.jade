include ./mixins.jade

+menubar
.content-box
	.model-left-content
		+header
		.content
			table.table.no-head
				tbody
					if dataset.url || reviewMode
						+field-row('url')
							if dataset.url
								a(href=dataset.url target='_blank')=dataset.url
					+field-row('year', true, true)
					if dataset.externalFile || reviewMode
						+field-row('externalFile')
							if dataset.externalFile
								a(href='#{fileBaseUrl}/#{dataset.externalFile}' target='_blank')=dataset.externalFile
					+field-row('textReference', true, true, null, null, true)
	+meta
	.clear