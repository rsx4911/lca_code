include ../../mixins/category-breadcrumb.jade
include ../../mixins/forms.jade
include ../../mixins/long-text.jade
include ../../mixins/user-info.jade

mixin download-dropdown()
	.dropdown.pull-right
		button.btn.btn-success.dropdown-toggle(data-toggle='dropdown' aria-haspopup='true' aria-expanded='false')
			span.glyphicon.glyphicon-download
			span.text Download
			span  
			span.caret
		ul.dropdown-menu
			li: a(href='#' data-format='json') as JSON-LD
			if $.inArray(getTypeAsEnum(dataset.type), ['ACTOR', 'SOURCE', 'UNIT_GROUP', 'FLOW_PROPERTY', 'FLOW', 'PROCESS', 'IMPACT_METHOD']) !== -1
				li: a(href='#' data-format='ilcd') as ILCD

mixin maximize-icon()
	li.maximize-content: a(href='#'): span.glyphicon.glyphicon-fullscreen

mixin menubar()
	if !isPublic
		.header-box
			- var currentCommit = null;
			+select('commitId', 'Version', null, null, true)
				each commit, i in commits
					if commit.id === commitId
						- currentCommit = commit;
					option(value=commit.id selected=commit.id===commitId)=i===0?'Latest':commit.id 
					optgroup.additional-info(label!='&nbsp; &nbsp;#{formatCommitDescription(commit.message)}')
			if dataset.deleted
				.badge.pull-right.deleted Deleted
			else
				+download-dropdown
			.clear
			+user-info(currentCommit.user, currentCommit.userDisplayName)(class='concealed' data-path='null')
				|  on #{formatDate(currentCommit.timestamp)}

mixin header()
	.title(class=isPublic?'header-box':null)
		img.pull-right.model-icon(src='images/model/large/#{getIcon(dataset)}')
		div
			h3(data-path='name')=dataset.name
			.category(data-path='category')
				- var url = null;
				- var path = null;
				if dataset.category
					- var typeLabel = getTypeLabel(getTypeAsEnum(dataset.type));
					- url = baseUrl + 's' + '/' + typeLabel;
					- path = dataset.category.name;
				+category-breadcrumb(url, path, true)
			h3: small: span(data-path='description'): +long-text(dataset.description, 500)
	block
	if !isPublic
		hr
	else
		p &nbsp;

mixin meta() 
	.model-right-content.content-box
		.meta-info
			if isPublic
				+download-dropdown
			div
				strong=getLabel('version')
				div=dataset.version?dataset.version:'-'
			div
				strong=getLabel('lastChange')
				div
					if dataset.lastChange
						| #{formatDate(dataset.lastChange)}
					else
						| -
			div
				strong=getLabel('id')
				div=dataset.id
			block

mixin field-row(path, showValue, checkValue, formatter, noDataPath, showLongText)
	- var value = showValue ? getValue(dataset, path) : null;
	if !checkValue || value || reviewMode
		tr
			td=getLabel(path)
			- value = formatter?formatter(value):value;
			td(data-path=noDataPath?null:path)
				if showLongText
					| #{value}
				else
					+long-text(value)
				block

mixin simple-ref(value)
	+ref(value, null, false, null, false, true)

mixin ref(pathOrValue, additionalTypeInfo, noImage, defaultLabel, commentPath, directValue)
	- var ref = directValue ? pathOrValue : getValue(dataset, pathOrValue);
	span(data-path=commentPath===false||directValue?null:commentPath?commentPath:pathOrValue)
		if ref
			if !noImage
				img.model-icon-small(src='images/model/small/#{getIcon(ref, additionalTypeInfo)}')
			- var query = commitId ? '?commitId=' + commitId : ''
			- var path = ref.category ? ref.category + '/' + ref.name : ref.name
			a(href='#{baseUrl}/#{getTypeAsEnum(ref.type)}/#{ref.id}#{query}' title=path)=ref.name
		else if defaultLabel
			| #{defaultLabel}

mixin ref-row(path, additionalTypeInfo, noImage)
	if getValue(dataset, path) || reviewMode
		tr
			td=getLabel(path)
			td: +ref(path, additionalTypeInfo, noImage)

mixin uncertainty(uncertainty, round)
	if uncertainty
		if uncertainty.distributionType === 'LOG_NORMAL_DISTRIBUTION'
			| Lognormal distribution
			br
			| Geom. mean: #{noToStr(uncertainty.geomMean, round)}
			br
			| Geom. SD: #{noToStr(uncertainty.geomSd, round)}
		else if uncertainty.distributionType === 'NORMAL_DISTRIBUTION'
			| Normal distribution 
			br
			| Mean: #{noToStr(uncertainty.mean, round)} 
			br
			| SD: #{noToStr(uncertainty.sd, round)}
		else if uncertainty.distributionType === 'TRIANGLE_DISTRIBUTION'
			| Triangle distribution
			br
			| Min: #{noToStr(uncertainty.minimum, round)}
			br
			| Mode: #{noToStr(uncertainty.mode, round)}
			br
			| Max: #{noToStr(uncertainty.maximum, round)}
		else if uncertainty.distributionType === 'UNIFORM_DISTRIBUTION'
			| Uniform distribution 
			br
			| Min: #{noToStr(uncertainty.minimum, round)}
			br
			| Max: #{noToStr(uncertainty.maximum, round)}

mixin parameter-table(input)
	- var parameters = getValue(dataset, 'parameters');
	- var isEmpty = true;
	- var putPath = true;
	if parameters
		each parameter in parameters
			if parameter.inputParameter && !input
				- putPath = false;
			if parameter.inputParameter === input
				- isEmpty = false;
	if !isEmpty
		h4=input?'Input parameters':'Dependant parameters'
		table.table.table-parameters
			thead
				tr
					th=getLabel('parameters[' + index + '].name')
					th=getLabel('parameters[' + index + '].description')
					if input
						th=getLabel('parameters[' + index + '].uncertainty')
					th
			tbody
				each parameter, index in parameters
					if parameter.inputParameter === input
						tr
							td #{parameter.name}
								if !input
									|  = #{parameter.formula}
								|  = #{parameter.value}
							td=parameter.description
							if input
								td: +uncertainty(parameter.uncertainty)
							td(data-path='parameters[' + parameter.name + ']')

mixin data-quality-matrix(system, uncertainties, entries)
	if system.indicators && system.indicators.length
		- clazz = ''
		if uncertainties
			- clazz += 'uncertainties'
		else if entries
			- clazz += 'center-inline'
		table.data-quality.no-head(class=clazz?clazz:null)
			thead
				tr
					th
					each score in system.indicators[0].scores
						th(data-path=uncertainties?null:'scores[' + score.position + ']')=score.label?score.label:score.position
			tbody
				each indicator in system.indicators
					tr
						td(data-path=uncertainties?null:'indicators[' + indicator.position + ']')=indicator.name?indicator.name:indicator.position
						each score in indicator.scores
							if uncertainties
								td(data-path='indicators[' + indicator.position + '].scores[' + score.position + '].uncertainty')=score.uncertainty
							else
								td(style='background-color:#{getDQColor(system, indicator, score, entries)}' data-indicator=indicator.position data-score=score.position)
									span(data-path='indicators[' + indicator.position + '].scores[' + score.position + '].description')=score.description

