include ./mixins.jade

+menubar
.content-box
	.model-left-content
		+header
		.content
			ul.nav.nav-tabs(role='tablist')
				li.active(role='presentation') 
					a(href='#overview' aria-controls='overview' role='tab' data-toggle='tab') Overview
				if dataset.processLinks && dataset.processLinks.length
					li(role='presentation')
						a(href='#process-tree' aria-controls='process-tree' role='tab' data-toggle='tab') Supply chain
					li(role='presentation')
						a(href='#process-graph' aria-controls='process-graph' role='tab' data-toggle='tab') Graph
				if (dataset.parameterRedefs && dataset.parameterRedefs.length) || reviewMode
					li(role='presentation') 
						a(href='#parameters' aria-controls='parameters' role='tab' data-toggle='tab' data-path='parameterRedefs')=getLabel('parameterRedefs')
			.tab-content
				#overview.tab-pane.active(role='tabpanel')
					table.table.no-head
						tbody
							+ref-row('referenceProcess')
							if dataset.referenceExchange || reviewMode
								+ref-row('referenceExchange.flow', 'PRODUCT_FLOW')
							+ref-row('targetFlowProperty')
							if dataset.targetUnit || reviewMode
								+field-row('targetUnit.name', true, true)
							+field-row('targetAmount', true, true)
				if dataset.processLinks && dataset.processLinks.length
					#process-tree.tab-pane(role='tabpanel')
						#process-tree-search
						#process-tree-container
					#process-graph.tab-pane(role='tabpanel')
						iframe(src='graph/graph.html' width='100%' height='500px')
				if (dataset.parameterRedefs && dataset.parameterRedefs.length) || reviewMode
					#parameters.tab-pane(role='tabpanel')
						if dataset.parameterRedefs && dataset.parameterRedefs.length
							table.table
								thead
									tr
										th=getLabel('parameterRedefs.context')
										th=getLabel('parameterRedefs.name')
										th=getLabel('parameterRedefs.value')
										th=getLabel('parameterRedefs.uncertainty')
								tbody
									each parameter, index in dataset.parameterRedefs
										tr
											td 
												if parameter.context
													+ref('parameterRedefs[' + index + '].context')
												else
													span(data-path='parameterRedefs[' + index + '].context') Global
											td(data-path='parameterRedefs[' + index + '].name')=parameter.name
											td(data-path='parameterRedefs[' + index + '].value')=parameter.value
											td(data-path='parameterRedefs[' + index + '].uncertainty')
												if parameter.inputParameter
													+uncertainty(parameter.uncertainty)
	+meta
		hr
		strong=getLabel('processes')
		div(data-path='processes')=dataset.processes?dataset.processes.length:0
		strong=getLabel('processLinks')
		div(data-path='processLinks')=dataset.processLinks?dataset.processLinks.length:0
	.clear