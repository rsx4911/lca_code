.filter-box
	strong #{path}
	button.btn.btn-success.pull-right(data-action='create-repository') 
		span.glyphicon.glyphicon-download
		| Download Zip
	.clear
table.table.table-browse
	thead
		tr
			th
			th Name
			th Last change
			th Commit
	tbody
		if !isRoot
			- var previousUrl = baseUrl;
			if parentRefId
				- previousUrl += '/' + parentRefId;
			tr
				td 
				td: a(href=previousUrl): strong ..
				td 
				td
		each entry in entries
			tr
				if isRoot
					td: img.model-icon-small(src='/images/model/small/category/#{entry.toLowerCase()}.png')
					td: a(href='#{baseUrl}/#{entry}'): strong  #{getRootLabel(entry)}
					td
					td
				else
					- var icon = null;
					if entry.type === 'CATEGORY'
						- icon = 'category/' + entry.categoryType.toLowerCase();
					else
						- icon = entry.type.toLowerCase();
						if entry.type === 'FLOW' && entry.flowType
							- icon += '_' + entry.flowType.substring(0, entry.flowType.indexOf('_'));
						else if entry.type === 'PROCESS' && entry.processType === 'LCI_RESULT'
							- icon += '_system'
					td: img.model-icon-small(src='/images/model/small/#{icon}.png')
					td
						if entry.type === 'CATEGORY'
							a(href='#{baseUrl}/#{entry.refId}'): strong #{entry.name}
						else
							a(href='#{datasetUrl}/#{entry.type}/#{entry.refId}'): strong #{entry.name}
					td #{formatLastUpdate(entry.lastUpdate)}
					td: a(href='/commit/#{entry.commitId}') #{entry.commitMessage}
