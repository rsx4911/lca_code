include ../mixins/forms.jade

form#clone-form
	#clone-form-general-message-group.alert(role='alert'): span.message
	+input('name', 'Name')
	+select('group', 'Group', groups)
	+select('commit', 'Version')
		each commit, i in commits
			option(value=commit.id)=i===0?'Latest':commit.id 
			optgroup.additional-info(label!='&nbsp; &nbsp;#{formatCommitDescription(commit.message)}')