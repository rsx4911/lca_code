include ../../mixins/user-info.jade

mixin comment-visibility(restrictedToRole, roles)
	- var title = 'Visible to everybody';
	if restrictedToRole
		- title = 'Only visible for users with role \'' + getRoleLabel(restrictedToRole) + '\' or higher';
	.change-visibility.dropdown
		a(href='#' data-toggle='dropdown')
			span.comment-visibility.glyphicon(class=!restrictedToRole?'glyphicon-globe':'glyphicon-lock' title=title)
		ul.dropdown-menu
			li: a(href='#' data-role='null') Everybody
			li.dropdown-submenu
				a(href='#') Specific role 
					.caret.right
				ul.dropdown-menu
					each role in roles
						li: a(href='#' data-role=role.id)=role.name

mixin comment-info(comment, roles, showDatasetInfo)
	- var canChangeVisibility = canComment && (currentUser.admin || currentUser.username === comment.user.username);
	span: small wrote on #{formatDate(comment.date)}
	if canChangeVisibility
		| &nbsp;
		+comment-visibility(comment.restrictedToRole, roles)
	if (!comment.released && comment.user.username === currentUser.username) || (comment.released && !comment.approvedBy && canApprove)
		|  | 
		a.default-link.release(href='#')
			small=!comment.released?'Release':'Approve'
	if comment.released && !comment.approvedBy && !canApprove
		|  | 
		i: small Approval pending
	if !comment.replyTo && canComment && comment.released && !!comment.approvedBy
		|  | 
		a.default-link.reply-to(href='#')
			small Reply
	if (!comment.released || !comment.approvedBy) && canEdit && comment.user.username === currentUser.username
		|  | 
		a.default-link.edit(href='#')
			small Edit
		|  
		a.remove(href='#'): span.glyphicon.glyphicon-remove

mixin comment-entry(comment, roles, showDatasetInfo)
	- var classes = [];
	if comment.replyTo
		- classes.push('reply');
	if comment.released 
		if comment.approvedBy
			- classes.push('approved');
		else
			- classes.push('released');
	- var addClass = null;
	if classes.length
		- addClass = '';
		each c, index in classes
			if index > 0
				- addClass += ' '
			- addClass += c;
	.comment-entry(class=addClass data-comment-id=comment.id)
		if showDatasetInfo
			.pull-left
				img.avatar.avatar-small(src='ws/user/avatar/#{comment.user.username}')
			.comment-info-container
				strong=comment.user.name
				|  
				+comment-info(comment, roles, true)
				- var field = comment.field;
				- var label = getLabel(field);
				.dataset-link: a.default-link(href='#{comment.repositoryPath}/dataset/#{field.modelType}/#{field.refId}?#{field.commitId?"commitId="+field.commitId:""}&commentPath=#{field.path||"null"}') 
					img.model-icon-small(src='images/model/small/#{field.modelType.toLowerCase()}.png')
					small #{comment.dsPath} 
						if label
							| - #{label}
			.clear
		else
			+user-info(comment.user.username, comment.user.name)
			+comment-info(comment, roles, false)
		.comment-text(class=!showDatasetInfo?'comment-layer':null)=comment.text