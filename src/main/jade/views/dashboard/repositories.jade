.header-box
	if canCreateRepositories
		.input-group.input-group-lg
			input#filter.form-control(type='text' placeholder='Filter by name')
			span.input-group-btn
				button.btn.btn-success(data-action='create-repository') 
					span.glyphicon.glyphicon-plus
					span.text Create new repository
	else
		.form-group
			input#filter.form-control.input-lg(type='text' placeholder='Filter by name')
#repositories.content-box