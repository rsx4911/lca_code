include ../mixins/forms.jade
include ../mixins/avatar-box.jade
include ../mixins/user-info.jade

div(class=team.id?'two-columns special':null)
	.team-info
		.header-box Team
			if team.id
				button.btn.btn-lg.btn-danger.pull-right(data-action='delete-team') Delete
		form#team-form.content-box
			#team-general-message-group.alert(role='alert'): span.message
			unless team.id
				+input('teamname', 'Teamname*')
			else
				+static('teamname', 'Teamname', team.teamname)
			+input('name', 'Name*')
			button.btn.btn-lg.btn-success.pull-right(data-action='save-team')
				if team.id
					| Save
				else
					| Create
			.clear
		if team.id
			+avatar-box('team', team.teamname, true)
	if team.id
		.team-members
			.flex-container
				.header-box Members (#{team.users.length})
					button.btn.btn-lg.btn-success.pull-right(data-action='add-members')
						span.glyphicon.glyphicon-plus
						span.text Add members
				.content-box
					each user in team.users
						+user-info(user.username, user.name)
							button.btn.btn-xs.btn-danger.pull-right(data-action='remove-member' data-username=user.username)
								span.glyphicon.glyphicon-minus