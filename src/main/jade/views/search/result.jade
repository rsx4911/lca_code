mixin result(dataset)
	.result
		if dataset.action === 'DELETE' && dataset.type === 'CATEGORY'
			+result-entry(dataset)
		else
			- var url = dataset.repositoryId + '/dataset';
			if dataset.type === 'CATEGORY'
				- url += 's/' + getLabel('modelType', dataset.categoryType) + '/' + dataset.fullPath;
			else
				- url += '/' + dataset.type + '/' + dataset.refId + '?commitId' + dataset.commitId;
			a(href=url): +result-entry(dataset)
		.details
			div Repository: 
				a(href='#{dataset.repositoryId}')=dataset.repositoryId
			if !isPublic
				div Commit: 
					a(href='#{dataset.repositoryId}/commit/#{dataset.commitId}') 
						span.result-text #{dataset.commitMessage} (#{dataset.commitId})

mixin result-entry(dataset)
	- var action = dataset.action;
	if action === 'DELETE' && dataset.type === 'CATEGORY'
		- action = null;
	if action && action !== 'UPDATE'
		if dataset.type === 'CATEGORY'
			img.model-icon-small(src='ws/public/cached/overlay/CATEGORY/#{dataset.categoryType}/#{action}')
		else if dataset.type === 'PROCESS' && dataset.processType
			- var processType = dataset.processType.toLowerCase() === 'system' ? 'LCI_RESULT' : 'UNIT_PROCESS';
			img.model-icon-small(src='ws/public/cached/overlay/PROCESS/#{processType}/#{action}')
		else if dataset.type === 'FLOW' && dataset.flowType
			img.model-icon-small(src='ws/public/cached/overlay/FLOW/#{dataset.flowType}/#{action}')
		else
			img.model-icon-small(src='ws/public/cached/overlay/#{dataset.type}/#{action}')
	else
		img.model-icon-small(src='images/model/small/#{getIcon(dataset)}')
	if dataset.action === 'DELETE'
		del.result-text=dataset.fullPath
	else 
		span.result-text=dataset.fullPath
