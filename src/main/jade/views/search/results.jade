include ../mixins/forms.jade
include ../mixins/paging.jade

.header-box #{total} results for '#{filter}'
	if filteredType
		|  and type '#{getTypeLabel(filteredType)}'
	.pull-right
		+select('type', 'Type', null, null, true)
			option All
			each type in modelTypes
				option(value='#{type}' selected=type===filteredType)=getTypeLabel(type)
	.clear
.content-box
	each dataset in data
		.result
			- var url = dataset.repositoryId + '/dataset';
			if dataset.type === 'CATEGORY'
				- url += 's/' + getTypeLabel(dataset.categoryType) + '/' + dataset.fullPath;
			else
				- url += '/' + dataset.type + '/' + dataset.refId + '/' + dataset.commitId;
			a(href=url)
				if dataset.type === 'CATEGORY'
					img.model-icon-small(src='images/model/small/category/#{dataset.categoryType.toLowerCase()}.png')
				else
					img.model-icon-small(src='images/model/small/#{dataset.type.toLowerCase()}.png')
				span.result-text=dataset.fullPath
			.details
				div Repository: 
					a(href='#{dataset.repositoryId}')=dataset.repositoryId
				div Commit: 
					a(href='#{dataset.repositoryId}/commit/#{dataset.commitId}') 
						span.result-text #{dataset.commitMessage} (#{dataset.commitId})
	+paging(page, Math.ceil(total/pageSize))