include ../mixins/forms.jade
include ../mixins/avatar-box.jade

.two-columns.special.flex-layout
	div
		.header-box Info
			if group.userCanDelete
				button.btn.btn-lg.btn-danger.pull-right(data-action='delete-group') Delete
		.content-box
			+static('name', 'Name', group.name)
		+avatar-box('group', group.name, group.userCanWrite)
	.repositories.flex-column
		.flex-container
			.header-box Repositories (#{repositories.length})
				if group.userCanWrite
					button.btn.btn-lg.btn-success.pull-right(data-action='create-repository')
						span.glyphicon.glyphicon-plus
						span.text Create new
			.list-container
				each repo in repositories
					.list-entry
						img.avatar(src='ws/repository/avatar/#{repo.group}/#{repo.name}')
						a.follow(href='#{repo.group}/#{repo.name}')
							strong #{repo.group}/#{repo.name}