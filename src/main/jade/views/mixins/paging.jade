mixin paging(page, pageCount, getUrl)
	if !getUrl
		- getUrl = function() {return '#';};
	if pageCount > 1
		.paging
			- var startPage = 1;
			- var endPage = 10;
			if page > 4
				- startPage = page - 4;
				- endPage = page + 5;
			if pageCount <= endPage
				- endPage = pageCount;
			if page > 1
				span: a.page(href=getUrl(1) data-page=1) <<
				span: a.page(href=getUrl(page-1)  data-page=page-1) <
			- var p = startPage
			while p <= endPage
				- var isActive = (p === page)
				- var isFirstAfterActive = (p === page + 1)
				if isActive
					span #{p}
				else
					span(class=isFirstAfterActive?'indent':''): a.page(href=getUrl(p) data-page=p) #{p}
				- p++;
			if page < pageCount
				span: a.page(href=getUrl(page+1) data-page=page+1) >
				span: a.page(href=getUrl(pageCount) data-page=pageCount) >>