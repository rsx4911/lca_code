include ../mixins/forms.jade

h4
	if !adminArea
		| Profile
	else if user.id
		| Profile: #{user.name} 
		button.btn.btn-lg.btn-danger.pull-right(data-action='delete-user') Delete
	else
		| New profile
legend Account
form#user
	#user-general-message-group.alert(role='alert'): span.message
	unless user.id
		+input('username', 'Username*')
	else
		+static('username', 'Username', user.username)
	+input('name', 'Name*')
	+input('email', 'Email*')
	button.btn.btn-lg.btn-success.pull-right(data-action='save-user')
		if user.id
			| Save
		else
			| Create
if user.id
	legend Password
	form#password
		#password-general-message-group.alert(role='alert'): span.message
		+input('password', 'Password', 'password')
		+input('password2', 'Password (repeated)', 'password')
		button.btn.btn-lg.btn-success.pull-right(data-action='save-password') Save
.clear