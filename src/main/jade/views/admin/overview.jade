mixin box(label, plural, count)
	- var lcLabel = label.toLowerCase()	
	- var lcPlural = plural.toLowerCase()	
	.header-box
		h4 #{plural}
		.count #{count}
		hr
		button.btn.btn-lg.btn-full-width.btn-success(data-action='create-#{lcLabel}') Create #{lcLabel}
	.list-box
		legend All #{lcPlural} 
			if label === 'Repository'
				button.btn.btn-xs.btn-default(data-action='reindex-repositories') Reindex
			input.form-control.input-sm.filter.pull-right(id='#{lcLabel}-filter' type='text' placeholder='filter')
			.clear
		div(id='#{lcPlural}')

.four-columns
	div
		+box('Repository', 'Repositories', repositories)
	div
		+box('User', 'Users', users)
	div
		+box('Group', 'Groups', groups)
	div
		+box('Team', 'Teams', teams)
.clear
