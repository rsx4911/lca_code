include ../mixins/forms.jade

form#add-members-form
	#add-members-general-message-group.alert(role='alert'): span.message
	+select('name', 'User/Team')(multiple=true class='member-selection')
		+optgroup('Users', users, null, 'users')
		+optgroup('Teams', teams, null, 'teams')
	+select('role', 'Role')
		each role in roles
			option(value=role.id)=role.name
			- var description = type === 'group' ? role.descriptionForGroup : role.descriptionForRepository
			optgroup.additional-info(label!='&nbsp; &nbsp;#{description}')
