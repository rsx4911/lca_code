include views/mixins/forms.jade

<!DOCTYPE html>
html(lang='en')
	head
		title='LCA Collaboration Server'
		meta(http-equiv='expires' content='0')
		meta(name='viewport' content='width=device-width, initial-scale=1')
		meta(name='fragment' content='!')
		link(rel='shortcut icon' type='image/x-icon' href='/images/favicon.ico')
		link(rel='stylesheet' type='text/css' href='/css/styles.css')
	body.login
		header
			.logo-container
				a(href='/')
					img.logo(src='/images/logo.png')
		#main-login
			#login-description
				h3 Welcome to the LCA Collaboration Server!
					div: small Manage LCA repositories with user specific access management that keeps your LCA data secure and enables collaboration. 
			#login-container
				h3 Sign in
				form#login
					#login-general-message.alert.alert-danger(role='alert'): span.message
					+input('username', 'Username')
					+input('password', 'Password', 'password')
					button.btn.btn-primary.pull-right(type='submit') Login
					.clear
		#footer &copy; 
			a(href='http://www.greendelta.com' target='_blank') GreenDelta GmbH
			|  
			span#year
			|  | 
			a(href='/imprint') Imprint
		.modal(style='display:none')
			.modal-dialog
				.modal-content
					.modal-header
						h4.modal-title Google Authenticator token required
					.modal-body.clearfix 
						p Please enter your Google Authenticator token to login
						input#token.form-control(type='text')
					.modal-footer
							button.btn.btn-default#cancel(tabindex=50 type='button') Cancel
							button.btn.btn-primary#ok(tabindex=50 type='button') Login
		script(src='/js/libs/jquery.js')
		script.
			$('#year').html(new Date().getFullYear());
			$('#login').on('submit', function(event) {
				var data = {username: $('#username').val(), password: $('#password').val()};
				$.ajax({type: 'POST', url: '/ws/public/login', contentType: 'application/json', data: JSON.stringify(data), 
					success: function(response) {
						if (response === 'tokenRequired') {
							$('#cancel').on('click', function() {
								window.location.href = '/'							
							});
							$('#ok').on('click', function() {
								data.token = parseInt($('#token').val())
								$.ajax({type: 'POST', url: '/ws/public/login', contentType: 'application/json', data: JSON.stringify(data),
									success: function() {
										window.location.href = '/'
									}, error: function(response) {
										$('#login-general-message').show();
										$('#login-general-message .message').html(response.responseText);
										$('.modal').hide()
										$('#token').val('');
									}
								});
							});
							$('.modal').show()
						} else {
							window.location.href = '/'
						}
					}, error: function(response) {
						$('#login-general-message').show();
						$('#login-general-message .message').html(response.responseText);
					}});
				return false;
			});
